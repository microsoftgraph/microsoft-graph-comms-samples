<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Skype.Bots.Media" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.20.0.348" newVersion="1.20.0.348" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  
  <!-- Add this section to handle missing localized resources -->
  <satelliteassemblies>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json.SourceGeneration" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <cultureinfo culture="zh-Hant" />
      </dependentAssembly>
    </assemblyBinding>
  </satelliteassemblies>
  
  <!-- Set default UI culture -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="false" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration> 
